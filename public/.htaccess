Options -Indexes

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On

    # Keep the public site on its canonical HTTPS hostname without trusting
    # forwarded headers from an untrusted direct request.
    RewriteCond %{HTTP_HOST} ^(?:www\.)?gisleynunesimoveis\.com\.br$ [NC]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^www\.gisleynunesimoveis\.com\.br$ [NC]
    RewriteRule ^ https://www.gisleynunesimoveis.com.br%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^painel\.gisleynunesimoveis\.com\.br$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://painel.gisleynunesimoveis.com.br%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:X-XSRF-TOKEN} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-TOKEN}]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
