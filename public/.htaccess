Options -Indexes

<FilesMatch "^\.user\.ini$">
    Require all denied
</FilesMatch>

# Defense in depth when the document root is ever mispointed at this
# directory or a deployment leaves a sensitive build artifact here.
<FilesMatch "^(?:\.env(?:\..*)?|\.git|.*\.log|artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|pnpm-lock\.yaml|phpunit\.xml|vite\.config\.js)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    # Static files are served by Apache and do not pass through Laravel's
    # SecurityHeaders middleware. Keep the browser baseline consistent for
    # those responses as well.
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Sensitive admin/auth routes must never disclose OAuth codes or one-use
    # invitations in Referer headers, including on redirects and errors.
    # THE_REQUEST preserves the original URL after Laravel's internal rewrite.
    Header always set Referrer-Policy "no-referrer" "expr=%{THE_REQUEST} =~ m#^\S+\s+/(?:api/(?:admin|auth)|admin|oauth/google/return)(?:/|\?|\s)#"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always set Strict-Transport-Security "max-age=31536000"

    # Remove provider-injected wildcard CORS from authentication and CRM routes.
    # The public catalogue may keep its separate CORS policy. Both Apache
    # response-header tables must be cleared, including error/preflight replies.
    # THE_REQUEST retains the original path after Laravel's internal index.php rewrite.
    Header unset Access-Control-Allow-Origin "expr=%{THE_REQUEST} =~ m#^\S+\s+/(?:api/(?:admin|auth)|admin|oauth/google/return)(?:/|\?|\s)#"
    Header always unset Access-Control-Allow-Origin "expr=%{THE_REQUEST} =~ m#^\S+\s+/(?:api/(?:admin|auth)|admin|oauth/google/return)(?:/|\?|\s)#"
    Header unset Access-Control-Allow-Credentials "expr=%{THE_REQUEST} =~ m#^\S+\s+/(?:api/(?:admin|auth)|admin|oauth/google/return)(?:/|\?|\s)#"
    Header always unset Access-Control-Allow-Credentials "expr=%{THE_REQUEST} =~ m#^\S+\s+/(?:api/(?:admin|auth)|admin|oauth/google/return)(?:/|\?|\s)#"

    # Unversioned JS/CSS revalidate. Only content-hash query URLs can be
    # retained immutably; HTML and authenticated API responses are excluded.
    Header set Cache-Control "public, max-age=0, must-revalidate" "expr=%{REQUEST_URI} =~ m#^/(?:assets|admin)/.*\.(?:js|css)$#"
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/(?:assets|admin)/.*\.(?:js|css)$# && %{QUERY_STRING} =~ m#^v=[a-f0-9]{64}$#"
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On

    # Keep the public site on its canonical HTTPS hostname without trusting
    # forwarded headers from an untrusted direct request.
    RewriteCond %{HTTP_HOST} ^(?:www\.)?gisleynunesimoveis\.com\.br$ [NC]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^www\.gisleynunesimoveis\.com\.br$ [NC]
    RewriteRule ^ https://www.gisleynunesimoveis.com.br%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^painel\.gisleynunesimoveis\.com\.br$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://painel.gisleynunesimoveis.com.br%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:X-XSRF-TOKEN} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-TOKEN}]

    # The admin shell exists as public/admin/index.html for the asset build, but
    # the entry point must still cross Laravel's admin-origin/security middleware.
    RewriteRule ^admin/index\.html$ /admin [R=308,L,NE]
    RewriteRule ^admin/?$ index.php [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
