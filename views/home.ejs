<%- include('partials/head') %>
  <body data-page="home">
    <%- include('partials/header') %>
    <main id="conteudo">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-dot"></span> imóveis com intenção</p>
          <h1 id="hero-title">Belo Horizonte,<br /><em>do seu jeito.</em></h1>
          <p class="hero-lead">Imóveis selecionados para quem quer viver a cidade com mais intenção, conforto e personalidade.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#imoveis">Explorar imóveis <span aria-hidden="true">↗</span></a>
            <a class="hero-secondary-link" href="/sobre">Conheça nosso jeito de trabalhar</a>
          </div>
          <div class="hero-meta" aria-label="Diferenciais">
            <span><strong>BH</strong> atuação local</span>
            <span><strong>1:1</strong> atendimento próximo</span>
            <% if (site.crci) { %><span><strong>CRECI</strong> <%= site.crci %></span><% } %>
          </div>
        </div>
        <div class="hero-visual">
          <div class="hero-image-wrap"><img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=1600&q=85" alt="Casa contemporânea cercada por jardim ao entardecer" fetchpriority="high" decoding="async" /><span class="image-caption">Casa Bandeirantes · Belo Horizonte, MG</span></div>
          <div class="hero-seal" aria-label="Atendimento humano e especializado"><span>atendimento</span><strong>humano</strong><small>◆</small></div>
        </div>
      </section>

      <section class="search-card shell" aria-labelledby="search-title">
        <div class="search-head"><div><p class="eyebrow">encontre seu imóvel</p><h2 id="search-title">Qual é o seu próximo capítulo?</h2></div><span class="listing-count"><strong id="listing-count">00</strong> imóveis</span></div>
        <form id="search-form" class="search-form">
          <label class="field"><span>Eu quero</span><select id="purpose"><option value="all">Comprar ou alugar</option><option value="Comprar">Comprar</option><option value="Alugar">Alugar</option></select></label>
          <label class="field field-wide"><span>Bairro</span><select id="location"><option value="all">Todos os bairros</option></select></label>
          <label class="field"><span>Tipo de imóvel</span><select id="type"><option value="all">Todos os tipos</option></select></label>
          <label class="field"><span>Faixa de preço</span><select id="price" disabled><option value="all">Escolha comprar ou alugar</option></select></label>
          <label class="field"><span>Quartos</span><select id="bedrooms"><option value="all">Qualquer número</option><option value="1">1 quarto</option><option value="2">2 quartos</option><option value="3">3 quartos</option><option value="4+">4 ou mais</option></select></label>
          <button class="search-button" type="submit" aria-label="Buscar imóveis"><span>Buscar</span><span aria-hidden="true">⌕</span></button>
        </form>
        <div class="filter-summary" id="filter-summary" aria-live="polite"><span>carregando imóveis…</span></div>
      </section>

      <section class="section shell listings-section home-listings" id="imoveis" aria-labelledby="listings-title">
        <div class="section-heading"><div><p class="eyebrow">uma seleção para começar</p><h2 id="listings-title">Imóveis que pedem<br /><em>uma visita.</em></h2></div><a class="text-link" href="/imoveis">Ver todos os imóveis <span>↗</span></a></div>
        <div class="listing-grid" id="listing-grid"></div>
        <p class="empty-state" id="empty-state" hidden>Nenhum imóvel encontrado com esses filtros. <button type="button" id="clear-filters">Limpar filtros</button></p>
      </section>

      <section class="experience-section" id="experiencia" aria-labelledby="experience-title"><div class="shell experience-grid"><div class="experience-intro"><p class="eyebrow eyebrow-light"><span class="eyebrow-dot"></span> por trás de cada chave</p><h2 id="experience-title">A casa é sua.<br /><em>A jornada, nossa.</em></h2><p>A Gisley Nunes aproxima pessoas de espaços que fazem sentido para o jeito único de viver de cada uma. Sem pressa, sem letra miúda, sem atalhos.</p><a class="button button-light" href="/sobre">Conheça a Gisley Nunes <span aria-hidden="true">↗</span></a></div><div class="stats process-stats"><div class="stat"><strong>01</strong><span>entender o que<br />você procura</span></div><div class="stat"><strong>02</strong><span>selecionar opções<br />relevantes</span></div><div class="stat"><strong>03</strong><span>visitar e comparar<br />com calma</span></div><div class="stat"><strong>04</strong><span>conduzir proposta<br />e negociação</span></div></div></div></section>

      <section class="pathways-section shell" aria-labelledby="pathways-title"><div class="pathways-heading"><p class="eyebrow">por onde você quer começar?</p><h2 id="pathways-title">Encontre o caminho<br /><em>que combina com o momento.</em></h2></div><div class="pathways-grid"><a class="pathway-card pathway-card-dark" href="/imoveis"><span>01</span><strong>Comprar ou alugar</strong><p>Explore a curadoria disponível em Belo Horizonte e região.</p><b aria-hidden="true">↗</b></a><a class="pathway-card pathway-card-warm" href="/bairros"><span>02</span><strong>Buscar por bairro</strong><p>Comece pela localização que faz sentido para você.</p><b aria-hidden="true">↗</b></a><a class="pathway-card pathway-card-paper" href="/servicos"><span>03</span><strong>Conhecer os serviços</strong><p>Veja como a equipe pode acompanhar o seu próximo passo.</p><b aria-hidden="true">↗</b></a></div></section>

      <% if (testimonials?.length) { %><section class="section testimonials-section shell" id="depoimentos" aria-labelledby="testimonials-title"><div class="section-heading"><div><p class="eyebrow">quem já encontrou</p><h2 id="testimonials-title">Histórias que<br /><em>viraram lar.</em></h2></div><div class="quote-nav" aria-label="Controles de depoimentos"><button type="button" data-quote-prev aria-label="Depoimento anterior">←</button><button type="button" data-quote-next aria-label="Próximo depoimento">→</button></div></div><div id="testimonials-track"><% testimonials.forEach((item, index) => { %><div class="testimonial-feature"<% if (index !== 0) { %> hidden<% } %>><div class="quote-mark">“</div><blockquote><%= item.quote %></blockquote><div class="quote-author"><strong><%= item.author %></strong><span><%= item.location %><% if (item.year) { %> · <%= item.year %><% } %></span></div></div><% }) %></div></section><% } %>

      <section class="contact-section" id="contato" aria-labelledby="contact-title"><div class="shell contact-grid"><div><p class="eyebrow">vamos conversar</p><h2 id="contact-title">Seu próximo lugar<br />começa <em>aqui.</em></h2><p class="contact-copy">Conte um pouco do que você está buscando. A equipe Gisley Nunes retorna com atenção para entender o seu momento.</p><div class="contact-details"><span>Atendimento em <%= site.area %></span><a href="#contact-form">Falar com um especialista ↗</a></div></div><form class="contact-form" id="contact-form"><label class="contact-honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label><div class="form-row"><label>Seu nome<input required name="name" autocomplete="name" maxlength="120" placeholder="Como podemos chamar você?" /></label><label>Seu e-mail<input required type="email" name="email" autocomplete="email" maxlength="255" placeholder="voce@email.com" /></label></div><label>O que você procura?<select name="interest"><option>Quero comprar um imóvel</option><option>Quero alugar um imóvel</option><option>Quero anunciar meu imóvel</option><option>Tenho outra dúvida</option></select></label><label>Mensagem<textarea required name="message" rows="3" maxlength="3000" placeholder="Fale um pouco sobre o que você tem em mente..."></textarea></label><button class="button button-primary" type="submit">Enviar mensagem <span aria-hidden="true">↗</span></button><p class="form-privacy">Ao enviar, seus dados serão registrados no CRM para responder ao seu contato. <a href="/privacidade">Veja a política de privacidade.</a></p><p class="form-status" id="form-status" role="status"></p></form></div></section>
    </main>
    <%- include('partials/footer') %>
    <script type="module" src="<%= assets.js %>"></script>
  </body>
</html>
