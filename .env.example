NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=https://www.gisleynunesimoveis.com.br
ADMIN_ORIGIN=https://painel.gisleynunesimoveis.com.br
# Use "cloudflare" somente quando o backend estiver realmente atrás do proxy da Cloudflare.
TRUST_PROXY_MODE=
# Mantenha false até o origin estar bloqueado para acesso direto (firewall/AOP).
TRUST_CLIENT_IP_HEADER=false

DATABASE_URL=mysql://usuario:senha@host:3306/banco
# Produção exige TLS com validação do certificado.
DATABASE_SSL_MODE=verify
# Opcional para provedores com CA própria: certificado PEM em base64.
DATABASE_SSL_CA_BASE64=
# Identidades OAuth dos gestores principais, separadas por vírgula.
# E-mail NÃO concede acesso. Para descobrir o openId, tente entrar no painel:
# usuários ainda não autorizados recebem apenas o próprio Código de identidade OAuth.
GISELY_ADMIN_OPEN_IDS=
# Use no mínimo 32 caracteres aleatórios e nunca versione o valor real.
GISELY_SESSION_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
# Sessão: máximo absoluto de 8h; inatividade padrão de 60 min (aceita 15–240).
GISELY_ADMIN_IDLE_TIMEOUT_MINUTES=60
# Limite de sessões administrativas simultâneas por identidade (1 a 10). Padrão recomendado: 3.
GISELY_MAX_ADMIN_SESSIONS=3

# Cloudflare R2 — provider preferencial para fotos dos imóveis.
R2_ACCOUNT_ID=
R2_BUCKET=gisley-nunes-imoveis
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOAD_EXPIRES_SECONDS=600

MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
MANUS_PROJECT_ID=
# Storage legado: mantenha somente durante a migração; R2 tem prioridade quando configurado.
# A rota pública antiga fica desligada por padrão.
ENABLE_LEGACY_STORAGE_ROUTE=false
MANUS_API_URL=
MANUS_API_KEY=
