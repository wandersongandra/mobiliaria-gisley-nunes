APP_NAME="Gisley Nunes Imóveis"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.gisleynunesimoveis.com.br
ADMIN_ORIGIN=https://www.gisleynunesimoveis.com.br
# CIDRs oficiais Cloudflare aplicáveis ao proxy implantado, separados por vírgula.
# Não use "*" e não inclua IPs de clientes finais.
TRUSTED_PROXIES=
LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=gisley_nunes
DB_USERNAME=
DB_PASSWORD=
DATABASE_URL=
DB_SSL_VERIFY=true
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=
CACHE_STORE=file

# Grafia antiga preservada de proposito: o arquivo e config/gisley.php, mas estes
# nomes de ambiente continuam GISELY_* porque ja estao no .env implantado e no CI.
# Renomear aqui sem renomear em config/gisley.php faz os valores voltarem ao default.
GISELY_ADMIN_OPEN_IDS=
GISELY_ADMIN_IDLE_TIMEOUT_MINUTES=60
GISELY_MAX_ADMIN_SESSIONS=3

R2_ACCOUNT_ID=
R2_BUCKET=gisley-nunes-imoveis
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOAD_EXPIRES_SECONDS=600

MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
MANUS_PROJECT_ID=
