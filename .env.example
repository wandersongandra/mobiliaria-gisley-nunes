APP_NAME="Gisley Nunes Imóveis"
APP_ENV=production
APP_KEY=
APP_RELEASE_SHA=unknown
APP_RELEASE_BUILT_AT=unknown
APP_ASSET_VERSION=unknown
APP_DEBUG=false
APP_URL=https://www.gisleynunesimoveis.com.br
ADMIN_ORIGIN=https://painel.gisleynunesimoveis.com.br
# CIDRs oficiais Cloudflare aplicáveis ao proxy implantado, separados por vírgula.
# Não use "*" e não inclua IPs de clientes finais.
TRUSTED_PROXIES=
LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=gisley_nunes
DB_USERNAME=
DB_PASSWORD=
DATABASE_URL=
DB_SSL_VERIFY=true
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=__Host-gisley_session
# __Host- exige Domain ausente; mantenha vazio.
SESSION_DOMAIN=
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Grafia antiga preservada de proposito: o arquivo e config/gisley.php, mas estes
# nomes de ambiente continuam GISELY_* porque ja estao no .env implantado e no CI.
# Renomear aqui sem renomear em config/gisley.php faz os valores voltarem ao default.
GISELY_ADMIN_OPEN_IDS=
# E-mails Google verificados autorizados a fazer o primeiro bootstrap de gestor.
GISELY_ADMIN_BOOTSTRAP_EMAILS=
GISELY_ADMIN_IDLE_TIMEOUT_MINUTES=60
GISELY_MAX_ADMIN_SESSIONS=3

# Limiares horários para alertas agregados (não registram PII).
GISELY_SECURITY_LOGIN_ALERT_THRESHOLD=20
GISELY_SECURITY_EXPORT_ALERT_THRESHOLD=5
GISELY_SECURITY_DESTRUCTIVE_ALERT_THRESHOLD=5
GISELY_SECURITY_TEAM_ALERT_THRESHOLD=3

# Backups: usar apenas no ambiente operacional do cron, nunca em frontend ou Git.
# GISELY_BACKUP_OUTPUT_DIR=/ponto-de-montagem-privado/backup
# GISELY_BACKUP_MEDIA_ROOT=/home1/usuario/.../storage/app/private/media
# GISELY_BACKUP_MYSQL_DEFAULTS_FILE=/pasta-privada/mysql-backup.cnf
# GISELY_BACKUP_DATABASE=nome_real_do_banco
# GISELY_BACKUP_CERT_FILE=/pasta-privada/backup-public.pem
# GISELY_BACKUP_CERT_SHA256=impressao_digital_sha256_do_certificado

# Relativo à raiz do projeto (base_path) ou absoluto; nunca dentro de public/.
MEDIA_ROOT=storage/app/private/media

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: use a rota neutra abaixo como workaround para WAF/ModSecurity host-side.
GOOGLE_OAUTH_CALLBACK_PATH=/oauth/google/return
