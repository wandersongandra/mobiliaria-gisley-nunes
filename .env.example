NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=https://www.gisleynunesimoveis.com.br
ADMIN_ORIGIN=https://painel.gisleynunesimoveis.com.br
MEDIA_PUBLIC_ORIGIN=https://media.gisleynunesimoveis.com.br
# Use "cloudflare" somente quando o backend estiver realmente atrás do proxy da Cloudflare.
TRUST_PROXY_MODE=

DATABASE_URL=mysql://usuario:senha@host:3306/banco
# Gestores principais, separados por vírgula. Estes acessos são protegidos no CRM.
GISELY_ADMIN_EMAILS=admin@seudominio.com.br
# Use no mínimo 32 caracteres aleatórios e nunca versione o valor real.
GISELY_SESSION_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
# Limite de sessões administrativas simultâneas por usuário (1 a 10).
GISELY_MAX_ADMIN_SESSIONS=5

# Cloudflare R2 — provider preferencial para fotos dos imóveis.
R2_ACCOUNT_ID=
R2_BUCKET=gisley-nunes-imoveis
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOAD_EXPIRES_SECONDS=600

MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
MANUS_PROJECT_ID=
# Storage legado: mantenha somente durante a migração; R2 tem prioridade quando configurado.
# A rota pública antiga fica desligada por padrão.
ENABLE_LEGACY_STORAGE_ROUTE=false
MANUS_API_URL=
MANUS_API_KEY=
